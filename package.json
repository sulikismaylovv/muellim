{
  "name": "muellim",
  "version": "0.1.0",
  "description": "Quizzes you on the code in your pull request and teaches the parts you got wrong.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "muellim": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gate": "biome check . && tsc --noEmit && vitest run --passWithNoTests",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@inquirer/prompts": "8.7.4",
    "ai": "7.0.153",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.34",
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
